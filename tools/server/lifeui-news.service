# The daily news run (tools/news/daily.sh): weather -> briefing -> publish to LifeUI -> optional notes archive;
# Sundays the weekly digest, the 1st the monthly feed tuning. Started by lifeui-news.timer; by hand:
#     sudo systemctl start lifeui-news && journalctl -u lifeui-news -n 30
# Settings: /opt/lifeui/.env.agent. Working files: /var/lib/lifeui-news. Writing the archive (NEWS_ARCHIVE_DIR)
# needs that folder in ReadWritePaths below.
[Unit]
Description=LifeUI daily news briefing
Wants=network-online.target
After=network-online.target ollama.service

[Service]
Type=oneshot
User=lifeui
Group=lifeui
WorkingDirectory=/opt/lifeui
Environment=NEWS_STATE=/var/lib/lifeui-news
ExecStart=/bin/sh /opt/lifeui/tools/news/daily.sh
StateDirectory=lifeui-news
TimeoutStartSec=60min
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
#ReadWritePaths=/srv/data/Notes
