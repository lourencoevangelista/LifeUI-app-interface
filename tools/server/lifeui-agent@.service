# One LifeUI agent run on the home server. The instance is <where>-<slot>: cloud-morning, cloud-midday,
# cloud-evening (LifeUI + GitHub + calendar, answers the inbox) or pc-evening (LifeUI + Obsidian vault).
# Started by the lifeui-agent-*.timer units; by hand: sudo systemctl start lifeui-agent@cloud-morning
# Installed by tools/server/install_server.sh. Settings: /opt/lifeui/.env.agent (600, owner lifeui).
[Unit]
Description=LifeUI agent run (%i)
Documentation=file:///opt/lifeui/README.md
Wants=network-online.target
After=network-online.target ollama.service

[Service]
Type=oneshot
User=lifeui
Group=lifeui
WorkingDirectory=/opt/lifeui
# One run at a time: after a power-on, Persistent= timers may start several missed runs together.
ExecStart=/usr/bin/flock --wait 1800 /run/lifeui-agent/lock /opt/lifeui/.venv/bin/python -I tools/agent_runner.py run --where %i
RuntimeDirectory=lifeui-agent
RuntimeDirectoryPreserve=yes
TimeoutStartSec=45min
Nice=5

# Sandbox: the run can read its code and its settings, read your notes folders (OBSIDIAN_VAULT) and nothing else under /srv,
# write nothing anywhere except its private /tmp, and talk only over IP (LifeUI, GitHub, calendar, Ollama).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
# The vaults, read-only; the rest of /srv (other files, backups) is not there at all. "-": a missing vault is skipped.
# One line per folder in OBSIDIAN_VAULT (install_server.sh checks that they match).
TemporaryFileSystem=/srv:ro
BindReadOnlyPaths=-/srv/data/Notes
