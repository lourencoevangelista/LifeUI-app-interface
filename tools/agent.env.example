# Settings for tools/agent_runner.py. Copy to  <repo>/.env.agent  (that name is git-ignored) and fill in.
#   Home server (Ubuntu): /opt/lifeui/.env.agent, owner lifeui, mode 600 (tools/server/install_server.sh checks it).
#   Windows PC: <repo>\.env.agent (tools/install_pc_task.ps1 writes OBSIDIAN_VAULT for you).
#   GitHub Actions (manual backup): the same values are repo secrets (see .github/workflows/agent.yml).

LIFEUI_URL=https://your-app.vercel.app
# Your time zone (IANA name). Used for "today"/"tomorrow", event proposals and the news day. Default UTC.
LIFEUI_TIMEZONE=UTC
# Agent tab > Settings > New token (shown once). Starts with lua_
LIFEUI_RUNNER_TOKEN=

# Which model writes the messages: anthropic (Claude API, the default) or ollama (a local model).
AGENT_PROVIDER=anthropic
# Default claude-opus-5-5 for anthropic, qwen3:8b for ollama
#AGENT_MODEL=qwen3:8b

# --- ollama only
#OLLAMA_URL=http://127.0.0.1:11434
# Context window in tokens (8192 fits qwen3:8b on a 6 GB GPU); the snapshot is trimmed to fit it
#AGENT_NUM_CTX=8192
# Longest answer in tokens; a longer one fails the run as "cut off (max_tokens)"
#AGENT_NUM_PREDICT=2048
# Retry once with Claude if the local model fails (needs ANTHROPIC_API_KEY); leave empty to just record the failure
#AGENT_FALLBACK=anthropic
#AGENT_FALLBACK_MODEL=claude-opus-5-5

# Needed for anthropic, or for ollama with AGENT_FALLBACK=anthropic
ANTHROPIC_API_KEY=

# --- cloud runs (inbox, GitHub, calendar)
# Fine-grained token, read-only (Contents + Issues + Metadata: read) on this repo only
#GITHUB_TOKEN=
#GITHUB_REPOSITORY=your-github-name/LifeUI
# Google Calendar > Settings > your calendar > "Secret address in iCal format"
#GCAL_ICS_URL=

# --- pc runs (Obsidian)
# The vault folder: e.g. /srv/data/Notes on a home server, C:\Users\You\Documents\Vault on Windows.
# Several vaults: separate them with : (Linux) or ; (Windows). On the server each one also needs a
# BindReadOnlyPaths line in tools/server/lifeui-agent@.service.
#OBSIDIAN_VAULT=/srv/data/Notes:/srv/data/Work-notes
# Folder names that are never read (default: .obsidian,.trash,Private). A note with `private: true` in its first lines is skipped too.
#OBSIDIAN_EXCLUDE=.obsidian,.trash,Private
